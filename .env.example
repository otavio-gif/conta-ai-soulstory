# Modelo de variaveis de ambiente. Copie para .env e preencha com os valores reais.
# O arquivo .env e ignorado pelo git e nunca deve ser versionado.

# Anthropic
ANTHROPIC_API_KEY=""

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""
DIRECT_URL=""
DATABASE_PASSWORD=""

# Jobs em background
TRIGGER_SECRET_KEY=""
# Ref do projeto no dashboard do Trigger.dev (Settings > General).
TRIGGER_PROJECT_REF=""

# Coleta
APIFY_TOKEN=""
FIRECRAWL_API_KEY=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
YOUTUBE_API_KEY=""

# Transcricao
OPENAI_API_KEY=""

# Notificacao
RESEND_API_KEY=""

# Acesso ao app (monousuario)
APP_ACCESS_PASSWORD=""

# Geracao de documento (skill soulstory-docx). Se vazio, usa o fallback embutido.
# Ex.: SOULSTORY_DOCX_CMD="python .claude/skills/soulstory-docx/build.py"
SOULSTORY_DOCX_CMD=""
# Bucket do Supabase Storage para os relatorios gerados.
SOULSTORY_REPORT_BUCKET="report-artifacts"
